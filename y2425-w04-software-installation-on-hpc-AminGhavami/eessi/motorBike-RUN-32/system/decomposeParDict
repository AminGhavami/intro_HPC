FoamFile
{
    format          ascii;
    class           dictionary;
    location        "system";
    object          decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

numberOfSubdomains 32;

decomposer      hierarchical;

distributor     ptscotch;

hierarchicalCoeffs
{
    n               ( 8 4 1 );
    order           xyz;
}


